{
  "name": "lps",
  "version": "0.1.0",
  "description": "LPS — index of installed and running programs for Debian/Ubuntu",
  "type": "module",
  "bin": {
    "lps": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "schema:sync": "bun run scripts/gen-schema-sql.ts",
    "build": "prisma generate && bun build ./src/index.ts --compile --outfile dist/lps",
    "check": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:smoke": "bun test src/core/db.test.ts",
    "verify": "tsc --noEmit && bun test",
    "doctor": "bun run src/index.ts doctor",
    "scan": "bun run src/index.ts scan",
    "clean": "rm -rf dist dev.db dev.db-wal dev.db-shm"
  },
  "devDependencies": {
    "@prisma/driver-adapter-utils": "7",
    "@types/bun": "latest",
    "prisma": "7",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@prisma/client": "7"
  }
}
